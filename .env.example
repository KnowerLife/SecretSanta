# Шаблон окружения для docker-compose.v69.yml.
# Скопируйте в .env (файл уже исключён из Git) и замените заглушки.

# Порт Hono API внутри контейнера и на хосте. Web всегда слушает 3000.
PORT=8787

# Путь к SQLite внутри контейнера. Не меняйте каталог: в compose он совпадает
# с точкой монтирования именованного тома v69_api_data.
SECRET_SANTA_V69_DB_PATH=/app/apps/api/data/app.db

# Адрес API для SSR и прокси /api. Внутри сети compose используется имя сервиса api.
SECRET_SANTA_API_TARGET=http://api:8787

# Секрет подписи токенов/сессий. Обязательно замените на случайную строку.
SECRET_SANTA_SECRET=replace-with-a-random-secret

# Ключи VAPID для Web Push. Заглушки отключают реальную доставку уведомлений.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# Контакт, который попадает в подпись Web Push.
VAPID_SUBJECT=mailto:admin@example.com

# Брокер событий между процессами API и воркера. В compose значения по умолчанию
# равно redis://redis:6379; вне compose пустое значение оставляет in-memory шину.
# REDIS_URL=redis://redis:6379

# Тег образов API и web; предыдущий тег можно использовать для отката.
V69_IMAGE_TAG=95

# Необязательные префиксы имён образов: registry (например, ghcr.io) и
# namespace (например, github-org). Слэш добавляется автоматически.
# Пустые значения сохраняют локальные имена secret-santa-api / secret-santa-web.
V69_IMAGE_REGISTRY=
V69_IMAGE_NAMESPACE=

# --- Наблюдаемость и приватная аналитика (всё необязательно) ---
# Пустые значения полностью отключают отправку данных. См. docs/OBSERVABILITY.md.

# DSN для Hono API (runtime). Подходит sentry.io, Bugsink и GlitchTip.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# APP_VERSION=v9.5.0

# DSN для web/SSR. Нужен на этапе сборки Pages (build-time).
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_APP_VERSION=v9.5.0

# Код сайта GoatCounter: только статическая витрина, без кук и без /room/*.
# VITE_GOATCOUNTER_CODE=

# Адрес публичного API и ключ UptimeRobot для scripts/uptimerobot-sync.mjs.
# MONITOR_API_URL=
# UPTIMEROBOT_API_KEY=
