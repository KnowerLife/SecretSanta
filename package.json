{
  "name": "secret-santa",
  "version": "9.5.0",
  "private": true,
  "type": "module",
  "description": "SecretSanta: PWA for a Secret Santa game on TanStack Start, Mantine and Hono",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "verify:frontend:v69": "node scripts/verify_frontend_v69.mjs",
    "verify:frontend:v69:quick": "node scripts/verify_frontend_v69.mjs --quick",
    "check:i18n-unused": "npm run check:unused-keys --workspace @secret-santa/shared",
    "dev": "npm run dev --workspace @secret-santa/web",
    "dev:api": "npm run dev --workspace @secret-santa/api",
    "build": "npm run build --workspace @secret-santa/api && npm run build --workspace @secret-santa/web",
    "build:pages": "npm run build:pages --workspace @secret-santa/web",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/art/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --test packages/shared/src/*.test.ts packages/art/src/*.test.ts apps/api/src/*.test.ts apps/web/src/shared/api/localState.test.ts apps/web/src/features/quick-draw/pairs.test.ts scripts/motion.test.mjs",
    "art": "node packages/art/scripts/generate.ts",
    "migrate:v68": "node apps/api/src/migrate-v68.ts",
    "openspec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@mantine/core": "9.8.2",
    "@mantine/form": "9.8.2",
    "@mantine/hooks": "9.8.2",
    "@mantine/notifications": "9.8.2",
    "@tabler/icons-react": "3.53.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "animate.css": "4.1.1",
    "hono": "4.13.22",
    "ioredis": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.2.0",
    "@types/node": "22.18.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.55.1",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
